# Copy to .env and fill in, then `set -a && source .env && set +a` before
# running any cdk command.
#
# SLACK_WORKSPACE_ID and SLACK_CHANNEL_ID both come out of the official Slack
# setup tutorial -- the workspace has to be authorized by hand once, and that
# same tutorial covers where each ID is shown:
# https://docs.aws.amazon.com/chatbot/latest/adminguide/slack-setup.html
# See also the "Prerequisito" section of README.md.

SLACK_WORKSPACE_ID=T0XXXXXXXXX
SLACK_CHANNEL_ID=C0XXXXXXXXX

# Optional
# ENV_NAME=demo
# DEMO_RESOURCES=true
